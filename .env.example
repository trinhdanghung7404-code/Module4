PORT=5000
CLIENT_URL=http://localhost:5173

# Cấu hình PostgreSQL Database
# Thay USERNAME và PASSWORD bằng tài khoản postgres của bạn
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ceramic_shop?schema=public"

# Cấu hình JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_key_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_random_string
JWT_REFRESH_EXPIRES=7d
